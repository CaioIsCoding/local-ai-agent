# Core Infrastructure
DATABASE_URL=postgresql://user:pass@db:5432/localai
REDIS_URL=redis://redis:6379/0

# AI & Media Services
OPENAI_API_KEY=sk-your-openai-key
PHOTOROOM_API_KEY=your-photoroom-key
CLAID_API_KEY=your-claid-key

# WhatsApp (Evolution API)
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=your-evolution-key
EVOLUTION_INSTANCE_NAME=local-ai-agent

# Social Publishing (Instagram)
INSTAGRAM_ACCESS_TOKEN=your-ig-token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-ig-account-id

# Social Publishing (Google Business Profile)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# Production Infrastructure (AWS S3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=local-ai-assets
AWS_ENDPOINT_URL=https://s3.amazonaws.com

# Observability
SENTRY_DSN=https://your-sentry-dsn
